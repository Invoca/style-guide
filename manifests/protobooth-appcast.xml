        <item>
            <title>Version 0.3.2</title>
            <pubDate>Thu, 03 Sep 2026 15:08:10 +0000</pubDate>
            <sparkle:shortVersionString>0.3.2</sparkle:shortVersionString>
            <sparkle:version>8</sparkle:version>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description><![CDATA[
                <ul>
                    <li>Fixed a bug where malformed edit responses from the AI could corrupt the prototype's HTML</li>
                    <li>Full chat replies are now kept in the thread behind a collapsible Details section instead of being cut short or lost</li>
                    <li>Added a "Copy link" action to the version menu for published versions</li>
                    <li>Links in chat messages now show a pointer cursor on hover</li>
                </ul>
            ]]></description>
            <enclosure
                url="https://raw.githubusercontent.com/Invoca/style-guide/protobooth-manifest/manifests/protobooth.dmg"
